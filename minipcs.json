          "gen": 11,
          "cpus": {
            "i7": "i7-1165g7"
          }
        },
        {
          "label": "NUC $1",
          "pattern": "\\bnuc\\s*(1[1-4])(?!\\s*[gt]b|\\d)",
          "gen": {
            "from": 1
          }
        },
        {
          "label": "NUC $1",
          "pattern": "\\bnuc\\s*(10|[5-9])\\s*i[3579]",
          "gen": {
            "from": 1
          }
        }
